# คัดลอกไฟล์นี้เป็น .env แล้วแก้รหัสผ่านก่อนใช้งานจริง
#   cp .env.example .env

# ---------- Airflow ----------
# บน Linux ให้ใส่ผลของคำสั่ง `id -u` / บน Windows, macOS ใช้ 50000 ได้เลย
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
# พอร์ตเว็บ Airflow บนเครื่องเรา
AIRFLOW_HOST_PORT=8080

# ฐานข้อมูล metadata ของ Airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow

# ---------- ฐานข้อมูลโปรเจกต์ (animedb) ----------
ANIMEDB_USER=anime
ANIMEDB_PASSWORD=anime_password
ANIMEDB_NAME=animedb
# พอร์ตบนเครื่องเรา (ใช้ต่อด้วย DBeaver / psql ได้)
ANIMEDB_HOST_PORT=5433
# พอร์ตแดชบอร์ด Streamlit
DASHBOARD_HOST_PORT=8501

# ---------- โหมดสาธิต ----------
# จำลองเว็บล่ม: ใส่ mal / anilist / kitsu (เว้นว่าง = ปกติ)
BREAK_SOURCE=
# ใส่แถวเสียปลอม 2 แถว เพื่อสาธิต quarantine (1 = เปิด)
INJECT_BAD_ROWS=
